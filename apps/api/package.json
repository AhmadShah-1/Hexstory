{
  "name": "@hexstory/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "start": "NODE_ENV=production tsx src/index.ts",
    "build": "tsc -p .",
    "migrate": "tsx src/migrate.ts",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "seed": "tsx src/seed.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.8",
    "@hexstory/shared": "*",
    "arctic": "^3.7.0",
    "aws4fetch": "^1.0.20",
    "fastify": "^5.12.7",
    "ioredis": "^5.11.1",
    "postgres": "^4.0.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "h3-js": "^4.5.0",
    "ioredis-mock": "^8.13.1",
    "vitest": "^5.0.5"
  }
}
