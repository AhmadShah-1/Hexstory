# Every environment variable the app reads. No real values here, ever.
# Locally: Doppler project "hexstory", config "dev" (`doppler secrets set NAME`).
# On Vercel: Project → Settings → Environment Variables (some injected by the Neon and Redis
# integrations). Full reference with scopes and secrecy: docs/DEPLOYMENT.md §7.

# --- Required ---
DATABASE_URL=postgres://hexstory:password@localhost:5432/hexstory   # Neon: the pooled URL (injected)
APP_ORIGIN=http://localhost:5173                                     # production: https://<your domain>

# --- Google sign-in (optional locally: without these the site is read-only) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ADMIN_EMAILS=you@example.com
# Place search geocoder (optional; default https://photon.komoot.io)
GEOCODER_URL=

# --- Migrations on Neon: direct (unpooled) connection (injected by the Neon integration) ---
DATABASE_URL_UNPOOLED=

# --- Image storage: "local" (default locally) or "r2" (default and required on Vercel) ---
STORAGE_BACKEND=local
UPLOAD_DIR=./uploads
R2_ENDPOINT=                 # https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_BUCKET=                   # public bucket, processed images
R2_STAGING_BUCKET=           # private bucket, uploaded originals
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=          # https://images.<your domain>

# --- Shared state between instances (optional; recommended on Vercel for shared rate limits and caches) ---
REDIS_URL=                   # redis://... or rediss://... (injected by the Redis integration)

# --- Support page links (public, not secrets; invalid values are ignored with a warning) ---
STRIPE_SUPPORT_URL=          # Stripe Payment Link, https://buy.stripe.com/<id>
PAYPAL_SUPPORT_URL=https://www.paypal.com/paypalme/hexstory   # PayPal.Me link

# --- Optional ---
PORT=3000
NODE_ENV=development         # defaults to production on Vercel
TRUST_PROXY=false            # defaults to true on Vercel
DB_POOL_MAX=                 # default 10 locally, 5 on Vercel

# --- Moderators' resource usage dashboard (all optional; docs/DEPLOYMENT.md "Resource usage dashboard") ---
USAGE_CLOUDFLARE_API_TOKEN=          # secret: token with only Account Analytics: Read
USAGE_CLOUDFLARE_ACCOUNT_ID=         # only if it can't be taken from R2_ENDPOINT
USAGE_NEON_API_KEY=                  # secret: project-scoped Neon key (Neon has no read-only key)
USAGE_NEON_PROJECT_ID=
USAGE_NEON_PLAN=                     # free (default) or paid
USAGE_LIMIT_NEON_STORAGE_GB=         # limits: never assumed; unset = no percentage
USAGE_LIMIT_NEON_COMPUTE_CU_HOURS=
USAGE_LIMIT_NEON_TRANSFER_GB=
USAGE_LIMIT_REDIS_MEMORY_MB=
USAGE_LIMIT_REDIS_CONNECTIONS=
USAGE_LIMIT_REDIS_OPS_PER_SEC=
USAGE_LIMIT_R2_STORAGE_GB_MONTH=
USAGE_LIMIT_R2_CLASS_A_MONTH=
USAGE_LIMIT_R2_CLASS_B_MONTH=
USAGE_WARN_PERCENT=                  # default 75
USAGE_CRITICAL_PERCENT=              # default 90
USAGE_CACHE_SECONDS=                 # default 900
