# Reference list of the secrets Doppler must provide (project "hexstory").
# Do not copy real values into files; use `doppler secrets set NAME`.

# Required
DATABASE_URL=postgres://hexstory:password@localhost:5432/hexstory
APP_ORIGIN=http://localhost:5173

# Google sign-in (optional in dev: without these the site is read-only)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional
PORT=3000
NODE_ENV=development
ADMIN_EMAILS=you@example.com
UPLOAD_DIR=./uploads
TRUST_PROXY=false
